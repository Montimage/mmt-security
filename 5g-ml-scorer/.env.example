# ─────────────────────────────────────────────────────────────────────────────
#  Kafka / STIX output channel for the 5G NAS-replay scorer (event_watch.py)
#  >>> FILL IN THE 4 KAFKA VALUES BELOW <<<
#
#  Read automatically by stix_kafka.py from this folder. No pip package needed.
#  A real exported environment variable always wins over a value set here.
#  Keep this file out of git / off any public share: it holds a password.
# ─────────────────────────────────────────────────────────────────────────────

# Broker address as "hostname:port" (mmt-probe.conf kafka-output: hostname + port)
MMT_KAFKA_BROKER=localhost:9092

# Topic the STIX bundles are published to (mmt-probe.conf kafka-output: topic)
MMT_KAFKA_TOPIC=report

# SASL/PLAIN credentials.
# Leave BOTH empty to connect without authentication (security.protocol=PLAINTEXT).
# When the username is non-empty we use SASL_PLAINTEXT + sasl.mechanism=PLAIN,
# exactly like mmt-probe does.
MMT_KAFKA_USERNAME=
MMT_KAFKA_PASSWORD=

# ── Optional: STIX identity fields (defaults match mmt-probe's own bundles) ──
# external_id of the x-attack-type object; keep it equal to the mmt-security rule id.
MMT_STIX_RULE_ID=500
# probe-id reported in the identity object's x-probe-id-ext extension.
MMT_STIX_PROBE_ID=MMT-PROBE-1

# Name written into the STIX x-attack-type object.
# LEAVE EMPTY to derive it from the traffic (recommended): the scorer reads the 5GMM
# message type of the replayed packets and reports e.g. "NAS Security Mode Command replay".
# Set a value only to pin a fixed taxonomy label (e.g. "UC1.2 NAS Replay Attack").
MMT_STIX_ATTACK_NAME=

# ── Troubleshooting / non-default brokers ──
# Override only if your broker rejects mmt-probe's defaults (SASL_PLAINTEXT + PLAIN):
#MMT_KAFKA_SECURITY_PROTOCOL=SASL_SSL
#MMT_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# Seconds to wait for the broker to acknowledge queued bundles before warning (default 15).
#MMT_KAFKA_FLUSH_TIMEOUT=15
# Uncomment to make librdkafka explain connection/auth failures in scorer.out.
#MMT_KAFKA_DEBUG=broker,security
# Raise if the broker is slow/far; the DEFAULT 30s is usually plenty. A timeout here
# almost always means unreachable-advertised-address, not slowness (run --diagnose).
#MMT_KAFKA_MESSAGE_TIMEOUT_MS=30000
# Number of broker acks required. librdkafka defaults to "all"; set to 1 to need only the
# partition leader. Use this when produce fails with _MSG_TIMED_OUT while the cluster looks
# healthy (--diagnose shows fewer in-sync replicas than min.insync.replicas requires).
#MMT_KAFKA_ACKS=1
